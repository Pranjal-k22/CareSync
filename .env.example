# HealConnect Environment Variables Reference Guide

# 1. Server Environment Configuration
ENVIRONMENT=production
DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-48-byte-secret
# Local-development only. Never enable in production; it provisions the
# requested admin and doctor demo accounts on first backend login.
ALLOW_INSECURE_DEMO_ADMIN=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 2. Database Credentials & Supabase Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/healconnect
SUPABASE_URL=https://your-supabase-project.supabase.co
# Backend only. Never expose this value in NEXT_PUBLIC_* variables or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Model Registry Artifact Paths
MODEL_PATH=backend/models/registry/deterioration/v1/model.joblib
DETERIORATION_MODEL_PATH=backend/models/registry/deterioration/v1/model.joblib
DISEASE_MODEL_PATH=backend/models/registry/disease/flu_v1/model.joblib

# 4. Frontend AI Backend Connection
NEXT_PUBLIC_AI_BACKEND_URL=http://127.0.0.1:8000

# 5. Firebase Authentication & Firestore Credentials
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# 6. MQTT Broker Configuration (IoTConnect)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_BROKER_WS_PORT=9001
MQTT_USERNAME=ingest_service_dev
MQTT_PASSWORD=ingest_password_789!
MQTT_CLIENT_ID=healconnect-backend-ingest

